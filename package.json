{
  "name": "tiparo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "aube@2.1.0",
  "scripts": {
    "content:sync": "node scripts/generate-font-manifest.mjs",
    "docs:diagrams": "node scripts/build-doc-diagrams.mjs",
    "docs:build": "aube run docs:diagrams && uv run --group docs zensical build --clean",
    "docs:serve": "aube run docs:diagrams && uv run --group docs zensical serve",
    "fonts:sync": "node scripts/sync-font-assets.mjs",
    "dev": "aube run content:sync && vite --force",
    "build": "aube run content:sync && tsc --noEmit && vite build",
    "pages:build": "aube run build && aube run docs:build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "latest",
    "react-dom": "latest",
    "react-zoom-pan-pinch": "4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "pele": "1.6.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
