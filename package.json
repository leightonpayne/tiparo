{
  "name": "tiparo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "archives:set-version": "bun scripts/set-archive-version.mjs",
    "content:sync": "bun scripts/generate-font-manifest.mjs",
    "docs:build": "uv run --group docs zensical build --clean",
    "docs:serve": "uv run --group docs zensical serve",
    "fonts:publish": "bun scripts/publish-font-archive.mjs",
    "fonts:sync": "bun scripts/sync-font-assets.mjs",
    "dev": "bun run content:sync && vite",
    "build": "bun run content:sync && tsc --noEmit && vite build",
    "pages:build": "bun run build && bun run docs:build",
    "preview": "bun run content:sync && vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "^4.83.0"
  }
}
